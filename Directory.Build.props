<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Warnings are errors in CI (CLAUDE.md convention); locally they stay warnings -->
    <TreatWarningsAsErrors Condition="'$(CI)' == 'true' or '$(TF_BUILD)' == 'true'">true</TreatWarningsAsErrors>
    <!--
      Except NuGet vulnerability advisories (NU1901-NU1904). An advisory is published
      against a package, not introduced by a commit: promoted to an error, a new one would
      fail every CI run on code nobody touched. They stay visible as warnings here and are
      checked instead by .github/workflows/audit.yml, on a schedule and on demand, which
      FAILS on any advisory in either published line.

      Here rather than as a -p: in the workflow so that `CI=true dotnet build` on a dev
      machine reproduces CI exactly, and so the exception sits next to the rule it narrows.
      Build policy only: it changes no byte of any package.
    -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

  <!--
    Package metadata, set once for every package rather than per project.

    Five packages whose versions can drift apart is a support problem: an inter-package
    dependency resolving to a mismatched version works on the machine that built it and
    fails on somebody else's. One property makes that impossible rather than unlikely.

    `PackageId` is deliberately absent — it defaults to the assembly name, which is
    already what each package should be called. The one exception sets it itself.
  -->
  <PropertyGroup>
    <!--
      The major tracks the UMBRACO major this package targets, not uBookIt's own
      breaking changes — see README.md's versioning note.

      Bumping this alone will FAIL THE TEST SUITE (not the build): VersionTruthTests
      reads this value and checks it against the documents that state the version
      uBookIt is CURRENTLY AT, so that prose has to follow the bump.

      BUT NOT EVERY VERSION IN THE DOCUMENTATION IS THAT KIND, AND A FIND-AND-REPLACE
      WILL BREAK THE OTHERS. "the first release is X" and "declared stable from X"
      record HISTORY: they are true because they do NOT move, and a bump must leave
      them exactly as they are. They are pinned against
      openspec/changes/archive/*-release-<version>, so moving all of them together
      still fails - which is what a repo-wide replace does, and what a reviewer caught
      this guard missing. If one of those sentences goes red, the fix is to put it
      back, never to edit it forward.

      Claims are matched by the PHRASINGS the guard knows rather than by scanning for
      version-shaped text — a new document inventing a new way to say it is not
      covered, so add the phrasing there when you add one.
    -->
    <Version>17.2.1</Version>

    <Authors>Norwood Design &amp; Development Ltd.</Authors>
    <Company>Norwood Design &amp; Development Ltd.</Company>
    <Product>uBookIt</Product>
    <Copyright>Copyright © Norwood Design &amp; Development Ltd.</Copyright>

    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!--
      The icon nuget.org and the Visual Studio Package Manager render beside the package.
      Without one, all five packages show a generic placeholder next to competitors that
      have one - and like every other value here it is FROZEN at push, so a wrong or
      missing icon costs a version number rather than a commit.

      The value is the path INSIDE the package; the file is put there by the ItemGroup
      below. NuGet's limits: 1MB, PNG or JPEG, 128x128 recommended.
    -->
    <PackageIcon>icon.png</PackageIcon>
    <!--
      NO umbraco-marketplace here. The Marketplace lists every package carrying that tag, and
      only the package a site installs should be listed: src/UBookIt/UBookIt.csproj appends
      it for itself. PackageCompositionTests checks the packed nuspecs.
    -->
    <PackageTags>umbraco;booking;bookings;scheduling;reservations</PackageTags>

    <!--
      The package's public home, and the repository the source actually lives in. Both
      are read by nuget.org and by the Umbraco Marketplace listing, so a consumer follows
      them out of a package page expecting to arrive somewhere they can read the code.

      ONE-WAY DOOR: nuget.org does not allow a pushed version's metadata to be edited, so
      an error here is not a commit away from fixed - it costs a version number and the
      bad listing stays visible. See docs/publishing.md before ANY push.

      NOTE the casing: the repository is UBookIt, which differs from the old Azure path.

      SourceLink does NOT read these - it derives the source-fetch URLs in the symbol
      package from the GIT REMOTE. Changing these two lines without switching the remote
      leaves the .snupkg pointing somewhere else entirely. Order matters; the runbook
      has it.
    -->
    <PackageProjectUrl>https://github.com/Chris-N2/UBookIt</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Chris-N2/UBookIt.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!--
      Deterministic-ish niceties that cost nothing and help a consumer debug: the symbol
      package means a stack trace through uBookIt has line numbers.
    -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!--
    One README, in every package, rather than a full one on the aggregate and a stub on
    each library.

    The design left this open and guessed at "full on the meta, pointer on the libraries".
    Rejected on apply for a reason this project keeps relearning: two documents saying
    overlapping things drift, and the drift is silent. Four identical copies are noise;
    two versions of the truth are a defect waiting to happen.

    Guarded on IsPackable so it is not attached to test projects, and `Condition="Exists"`
    so a partial checkout does not fail the build with a packaging error.
  -->
  <ItemGroup Condition="'$(IsPackable)' != 'false' AND Exists('$(MSBuildThisFileDirectory)README.md')">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!--
    The icon, packed on exactly the conditions the README above uses and for the same two
    reasons: not attached to test projects, and a partial checkout fails no build.
  -->
  <ItemGroup Condition="'$(IsPackable)' != 'false' AND Exists('$(MSBuildThisFileDirectory)assets\icon.png')">
    <None Include="$(MSBuildThisFileDirectory)assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
