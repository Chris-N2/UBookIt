<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <Title>uBookIt — domain</Title>
    <Description>The uBookIt booking domain: bookable resources, availability rules, services, slot generation and bookings. Depends on nothing — no Umbraco, no database, no framework — so a host can reference the model and the booking rules on their own. Part of uBookIt, a booking system for Umbraco; install the UBookIt package rather than this one.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UBookIt.Tests" />
    <!-- service-email-templates: IUBookItStorageReadyHandler is internal on purpose (Chris, QA
         round 1). Persistence calls it after migrating and Web implements it; no site needs it,
         so it is not a public extension point. Exactly the two assemblies that use it, plus the
         integration tests that drive it through the migration runner; the same released-together
         assumption as Persistence's grant to Backoffice. -->
    <InternalsVisibleTo Include="UBookIt.Persistence" />
    <InternalsVisibleTo Include="UBookIt.Web" />
    <InternalsVisibleTo Include="UBookIt.Tests.Integration" />
  </ItemGroup>

</Project>
