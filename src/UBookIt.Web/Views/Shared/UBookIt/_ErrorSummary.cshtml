@using UBookIt.Web.Rendering
@model IBookingFormView
@*
    The error summary, rendered once for every flow. Each problem is stated in
    text and links to the control it belongs to; the container is a live region
    so a no-JavaScript redraw announces itself, and is focusable so the deferred
    progressive-enhancement layer has something to move focus to.
*@
@{
    // Whether the control an error names is actually on this page.
    //
    // A link to a control that was not rendered is worse than no link: the summary
    // states the problem and then takes the visitor nowhere. The booker fields and
    // the time list are rendered only where there are times — both flows guard them
    // with `HasTimes` — so an error against them survives a redraw onto a date with
    // none, and would link into markup that does not exist. The length and the
    // choice are always on the page when they can be in error; both carry their id
    // on a wrapper when their control is replaced by settled text, for exactly this
    // reason.
    //
    // Found by the rendering suite: it noticed the summary pointing at nothing.
    // Stated exhaustively over the field ids that exist, rather than as a couple of
    // exceptions with everything else inheriting `HasTimes`. A field added later
    // would otherwise take on that meaning silently — absence deciding behaviour,
    // which is the shape this package rejects everywhere else. An unknown id is not
    // linked, because nothing here can say it is on the page.
    bool IsOnThePage(string fieldId)
        => fieldId switch
        {
            // Always rendered: both length branches carry the id, the settled one on
            // a wrapper precisely so this link has a target.
            BookingFieldIds.Duration => true,

            // Rendered wherever an error about it can exist — the select when a
            // choice is offered, the wrapper when it is not.
            BookingFieldIds.Resource => true,

            // The time list and the booker fields are shown only where there are
            // times to choose between.
            BookingFieldIds.Times or BookingFieldIds.Name or BookingFieldIds.Email
                => Model.HasTimes,

            _ => false,
        };
}
@if (Model.HasErrors)
{
    <div role="alert" tabindex="-1" class="ubookit-errors">
        <h3>There is a problem</h3>
        <ul>
            @foreach (var error in Model.Errors)
            {
                <li>
                    @if (error.FieldId is not null && IsOnThePage(error.FieldId))
                    {
                        <a href="#@error.FieldId">@error.Message</a>
                    }
                    else
                    {
                        @error.Message
                    }
                </li>
            }
        </ul>
    </div>
}
