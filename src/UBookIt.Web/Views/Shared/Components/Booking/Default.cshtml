@using UBookIt.Web.Rendering
@using Umbraco.Extensions
@model BookingFormModel
@*
    The single-resource booking flow. What is peculiar to it — the heading, the
    hidden resource id, the form it posts to — is here; the accessibility-critical
    markup it shares with the service flow is rendered from the shared partials so
    there is one copy to get right (design D1).
*@
<section class="ubookit-booking" aria-label="Book @Model.ResourceName">
    <h2>Book @Model.ResourceName</h2>

    @await Html.PartialAsync("~/Views/Shared/UBookIt/_ErrorSummary.cshtml", Model)

    @await Html.PartialAsync("~/Views/Shared/UBookIt/_DateAndLength.cshtml", Model)

    @* Step 2 — choose a time and enter details (POST, anti-forgery via BeginUmbracoForm). *@
    @using (Html.BeginUmbracoForm<BookingSurfaceController>(nameof(BookingSurfaceController.Submit)))
    {
        <input type="hidden" name="ResourceId" value="@Model.ResourceId" />
        <input type="hidden" name="Date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
        <input type="hidden" name="DurationMinutes" value="@Model.DurationMinutes" />
        @if (Model.FlowToken is { } token)
        {
            @* Only present when the dispatcher put the subject in the URL. Its
               absence is what keeps the redirect after a component-invoked
               submission byte-for-byte what it was before this flow existed. *@
            <input type="hidden" name="@nameof(BookingSubmission.Subject)" value="@token" />
        }

        @await Html.PartialAsync("~/Views/Shared/UBookIt/_Times.cshtml", Model)

        @if (Model.HasTimes)
        {
            @await Html.PartialAsync("~/Views/Shared/UBookIt/_YourDetails.cshtml", Model)
        }
    }
</section>
