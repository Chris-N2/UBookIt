@using UBookIt.Web.Rendering
@model CatalogueModel
@*
    What can be booked, as one set of choices. Services and directly-bookable
    resources are listed together and presented alike: whether a bookable thing is
    a service or a resource is an implementation distinction, and a visitor is not
    helped by being told which is which.

    A grouped set of radio controls inside a fieldset whose legend names what is
    being chosen — the same bar the start times meet, for the same reason.
*@
<section class="ubookit-catalogue" aria-label="Choose what to book">
    <h2>Choose what to book</h2>

    @if (Model.HasEntries)
    {
        <form method="get" class="ubookit-catalogue-form">
            @* The host page's query parameters, carried across the submission — a GET
               form REPLACES the query string, and this page's parameters are not ours
               to discard. Only site-listed names reach the model, never uBookIt's own
               keys (PreservedQuery.Compute). _DateAndLength renders the same loop:
               inlined in both rather than shared, because a shared partial in this
               folder joins the public theming contract, which this must not. *@
            @foreach (var pair in Model.PreservedQuery)
            {
                <input type="hidden" name="@pair.Name" value="@pair.Value" />
            }
            <fieldset class="ubookit-catalogue-choices">
                <legend>What would you like to book?</legend>
                @foreach (var (entry, index) in Model.Entries.Select((entry, index) => (entry, index)))
                {
                    var id = $"ubookit-book-{index}";
                    <div class="ubookit-catalogue-choice">
                        <input type="radio"
                               id="@id"
                               name="@BookingKeys.SubjectQuery"
                               value="@entry.Subject.Token"
                               required />
                        <label for="@id">@entry.Name</label>
                    </div>
                }
            </fieldset>
            <button type="submit" class="ubookit-submit">Continue</button>
        </form>
    }
    else
    {
        <p class="ubookit-no-choices">There is nothing available to book at the moment.</p>
    }
</section>
