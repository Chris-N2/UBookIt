<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Api.Common" />
    <PackageReference Include="Umbraco.Cms.Web.Website" />
  </ItemGroup>

  <!--
    The package manifest ImportBookingPageSchema installs from. It is resolved by
    resource name, derived from this path — so the folder and the migration's
    namespace must agree.

    A mismatch is NOT silent: the resource lookup throws, the plan is constructed
    during boot, and the site fails to start with BootFailedException and 500s every
    request. PackagingTests asserts the coupling anyway, because a failing test names
    the cause in a second and a failed boot costs a deploy to diagnose.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Packaging\package.xml" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UBookIt.Tests" />

    <!--
      The resolution guard lives in the rendering suite, because that is the only
      project whose dependency closure has no runtime compilation in it. It calls
      the package's own registration step so that what it measures is the package's
      behaviour rather than a chain the test assembled to suit itself.
    -->
    <InternalsVisibleTo Include="UBookIt.Tests.Rendering" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UBookIt.Core\UBookIt.Core.csproj" />
  </ItemGroup>

</Project>
