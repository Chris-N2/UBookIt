<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Api.Common" />
    <PackageReference Include="Umbraco.Cms.Web.Website" />
  </ItemGroup>

  <!--
    The package manifest BookingPagePackageMigrationPlan installs from. It is
    resolved by resource name, which is derived from this path — so the folder and
    the plan's namespace must agree. A mismatch is silent: the plan finds nothing
    and the site starts without uBookIt's schema. PackagingTests asserts it.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Packaging\package.xml" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UBookIt.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UBookIt.Core\UBookIt.Core.csproj" />
  </ItemGroup>

</Project>
