<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CompressionEnabled>false</CompressionEnabled> <!-- Disable compression. E.g. for umbraco backoffice files. These files should be precompressed by node and not let dotnet handle it -->

    <!--
      A development harness, not something anybody installs. It lives under src/ next to the
      four libraries, so `dotnet pack` on the solution would otherwise offer it a package.
      The test projects already declare this; this one was the omission.
    -->
    <IsPackable>false</IsPackable>

    <!--
      The Web SDK — and only the Web SDK, which is why the test projects are silent — warns
      when a solution-wide `dotnet pack` reaches a project that has opted out. The warning
      exists to catch an accidental opt-out; this one is deliberate, and packing the solution
      is how the packages are built. Saying so beats a warning nobody can act on.
    -->
    <WarnOnPackingNonPackableProject>false</WarnOnPackingNonPackableProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms" />
    <PackageReference Include="Umbraco.Cms.DevelopmentMode.Backoffice" />
  </ItemGroup>

  <ItemGroup>
    <!-- Opt-in to app-local ICU to ensure consistent globalization APIs across different platforms -->
    <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" />
    <RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="72.1.0.3" Condition="$(RuntimeIdentifier.StartsWith('linux')) or $(RuntimeIdentifier.StartsWith('win')) or ('$(RuntimeIdentifier)' == '' and !$([MSBuild]::IsOSPlatform('osx')))" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UBookIt.Backoffice\UBookIt.Backoffice.csproj" />
    <ProjectReference Include="..\UBookIt.Web\UBookIt.Web.csproj" />

    <!--
      The theme, so the mechanism is exercised live rather than only in the rendering
      rig. It is the same fixture the rendering suite measures precedence with, which
      is deliberate: the two configurations differ only in whether runtime compilation
      is present, so a disagreement between them is the finding, not a difference in
      what was themed.

      A real site would reference a theme package. Nothing here ships.
    -->
    <ProjectReference Include="..\..\tests\UBookIt.Tests.ThemeFixture\UBookIt.Tests.ThemeFixture.csproj" />
  </ItemGroup>


  <PropertyGroup>
    <!-- Razor files are needed for the backoffice to work correctly -->
    <CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Remove RazorCompileOnBuild and RazorCompileOnPublish when not using ModelsMode InMemoryAuto -->
    <RazorCompileOnBuild>false</RazorCompileOnBuild>
    <RazorCompileOnPublish>false</RazorCompileOnPublish>
    <!-- Deliberately DIFFERENT on every line: main (Umbraco 17), dev/v18 and dev/v19 each have
         their own id. User secrets are keyed by UserSecretsId, not by branch, so sharing one would
         mean sharing one connection string, and a newer Umbraco would migrate the older line's
         database, which that line can then no longer boot against. This line inherited dev/v18's
         id when it branched; the Umbraco 19 port gave it its own (database uBookIt_v19).
         Separate id, separate database. -->
    <UserSecretsId>80f44b82-1c52-4294-8c73-12962fc8ab26</UserSecretsId>
  </PropertyGroup>

</Project>
