@using UBookIt.Core.Stores
@inject IResourceStore ResourceStore
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = null;
    // Dev harness for change ⑤: render the default booking flow for the first
    // bookable resource, so the flow is reachable without hardcoding an id.
    //
    // `?resourceId=` overrides it. Added for the direct-booking permission, which
    // has two outcomes to look at — a resource offered on its own and one that is
    // not — and the first-resource default can only ever show one of them.
    var requested = Guid.TryParse(Context.Request.Query["resourceId"], out var id) ? id : (Guid?)null;

    var firstResource = requested is { } wanted
        ? await ResourceStore.GetAsync(wanted)
        : (await ResourceStore.ListAsync(0, 1)).Items.FirstOrDefault();

    // Dev harness for change ⑩. `?flow` renders the dispatcher, which reads
    // `ubBook` from the query and shows the catalogue when it says nothing;
    // `?flow=<serviceId>` renders that service directly, which is the "entry at
    // any point" case a site author with one service would use.
    var flow = Context.Request.Query.ContainsKey("flow");
    var namedService = Guid.TryParse(Context.Request.Query["flow"], out var svc) ? svc : (Guid?)null;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>uBookIt booking test</title>
</head>
<body>
    <main>
        <h1>uBookIt booking test</h1>
        @if (flow)
        {
            @(namedService is { } named
                ? await Component.InvokeAsync("BookingFlow", new { serviceId = named })
                : await Component.InvokeAsync("BookingFlow"))
        }
        else if (firstResource is not null)
        {
            @await Component.InvokeAsync("Booking", new { resourceId = firstResource.Id })
        }
        else
        {
            <p>No bookable resource found. Seed a resource in the backoffice first.</p>
        }
    </main>
</body>
</html>