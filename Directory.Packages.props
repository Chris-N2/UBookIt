<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Allow floating versions so extensions can align with the host Umbraco project's package versions -->
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Umbraco 18 (STS) — keep all Umbraco.Cms.* packages on the same version -->
    <PackageVersion Include="Umbraco.Cms" Version="[18.2.1,19.0.0)" />
    <PackageVersion Include="Umbraco.Cms.Api.Common" Version="[18.2.1,19.0.0)" />
    <PackageVersion Include="Umbraco.Cms.Api.Management" Version="[18.2.1,19.0.0)" />
    <PackageVersion Include="Umbraco.Cms.Web.Common" Version="[18.2.1,19.0.0)" />
    <PackageVersion Include="Umbraco.Cms.Web.Website" Version="[18.2.1,19.0.0)" />
    <PackageVersion Include="Umbraco.Cms.DevelopmentMode.Backoffice" Version="[18.2.1,19.0.0)" />
    <PackageVersion Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Persistence (EF Core major aligned with Umbraco 18.2.x / .NET 10) -->
    <PackageVersion Include="Umbraco.Cms.Persistence.EFCore" Version="[18.2.1,19.0.0)" />
    <!-- Used directly: UBookIt.Web calls AddOpenApi/AddSchemaTransformer and
         UBookIt.Backoffice implements IOpenApiOperationTransformer. It arrives
         transitively through Umbraco 18 too, but a package we compile against is a
         dependency we should state. -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- SECURITY PIN, not a feature. The October 2026 .NET advisories (published 2026-10-13)
         against System.Security.Cryptography.Pkcs, GHSA-846f-f764-76mx and GHSA-2fmv-rv2c-59x7,
         fixed in 10.0.13. Pkcs reaches the shipped packages transitively (EF Core's SqlClient,
         MailKit), the SDK does not prune it, and no Umbraco release yet depends on a
         fixed version. So the packable projects that resolve a vulnerable version reference the
         fix directly, except where a uBookIt dependency already brings it (Persistence and Web
         do; Backoffice and UBookIt reach it through them), which raises the minimum in their
         packed nuspecs, and a site then runs the
         fixed DLL (newer than the framework's copy).
         The same day's System.Security.Cryptography.Xml advisories are NOT pinned: the SDK prunes
         that package from every project referencing the ASP.NET Core shared framework (it is on
         the framework's prune list; Pkcs is not), so every site runs the framework's copy and only
         a .NET runtime update fixes it (design D6).
         Direct references, NOT CentralPackageTransitivePinningEnabled: that would also pin every
         other entry in this file wherever it is reached transitively and declare it in the nuspec.
         EXIT: remove this, and the references to it, in the change that raises the Umbraco floor
         to a release whose own graph resolves 10.0.13 or later (crypto-advisories-2026-10,
         design D5). -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- SECURITY PIN, not a feature. GHSA-qhrr-8q5h-9q3h (CVE-2026-92707, medium, published
         2026-10-15): MessagePack before 3.1.9 can allocate excessive memory deserializing nested
         arrays into System.Object. MessagePack reaches the shipped packages only through Umbraco
         (Umbraco.Cms.Web.Common and its HybridCache, 17.7.1, depend on 3.1.8), and no stable
         Umbraco release yet depends on a fixed version. So the packable projects that resolve it
         reference the fix directly: Backoffice and Web, which are siblings; UBookIt reaches it
         through them, and Persistence and Core do not have MessagePack at all. 3.1.9 is the first
         fixed version. Unlike Xml, the SDK does not prune MessagePack, so the package declaration
         reaches every site.
         Direct references, NOT CentralPackageTransitivePinningEnabled, for the reason given above.
         EXIT: remove this, and the references to it, together with the Pkcs pin, in the change
         that raises the Umbraco floor to a release whose own graph resolves MessagePack 3.1.9 or
         later (expected: 17.8.0, whose release candidate brings 3.1.11; messagepack-advisory,
         design D4). -->
    <PackageVersion Include="MessagePack" Version="3.1.9" />
  </ItemGroup>

  <ItemGroup>
    <!-- Testing (integration tests use xunit v3 for runtime Assert.Skip) -->
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />

    <!-- Rendering tests parse the HTML the views produce; assertions like "every
         aria-describedby resolves" want a real DOM rather than a regex. Test-only:
         nothing here ships in the package. -->
    <PackageVersion Include="AngleSharp" Version="1.7.1" />

    <!-- The publishing-workflow guards parse .github/workflows as YAML, for the same reason:
         four QA rounds each found a YAML form that a line scanner misread (quoted keys, escapes,
         block-scalar indentation, a value on the next line, the `?` key indicator). Test-only:
         nothing here ships in the package. MIT. -->
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>
</Project>
